# Supabase — database, auth (magic link), and pre-payment lead storage.
# Anon key is used client-side only for auth (sign-in/sign-out) — never for
# table reads/writes, which stay server-side via the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Coach login (magic-link auth is shared with clients; this just decides
# which authenticated email lands on /coach instead of /portal).
COACH_EMAIL=

# Public Calendly/Cal.com booking link, embedded in the client portal and
# included in the coach's "time to book your call" message.
NEXT_PUBLIC_BOOKING_URL=

# Stripe — Price IDs, not Payment Link URLs. Checkout Sessions are created
# server-side (app/api/create-checkout-session) so the success/cancel URLs
# and client_reference_id can be set per request. DIY, 3-month, and 6-month
# are all one-time prices (the 3/6mo price should be the FULL TERM TOTAL —
# e.g. $597 for 3 months at $199/mo — not a per-month recurring price).
# 1-month is the only real subscription: a plain recurring monthly price,
# cancelable any time, no scheduled end. Also add the webhook secret to
# verify checkout.session.completed events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DIY=
STRIPE_PRICE_1MO=
STRIPE_PRICE_3MO=
STRIPE_PRICE_6MO=

# My Macros+ — server-side only, never exposed to the browser.
MYMACROS_API_KEY=

# Absolute site URL, used for Stripe success/return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
