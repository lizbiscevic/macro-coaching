# Supabase — database, auth (magic link), and pre-payment lead storage.
# Anon key is used client-side only for auth (sign-in/sign-out) — never for
# table reads/writes, which stay server-side via the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Coach login (magic-link auth is shared with clients; this just decides
# which authenticated email lands on /coach instead of /portal).
COACH_EMAIL=

# Public Calendly/Cal.com booking link, embedded in the client portal and
# included in the coach's "time to book your call" message.
NEXT_PUBLIC_BOOKING_URL=

# Stripe — Price IDs, not Payment Link URLs. Checkout Sessions are created
# server-side (app/api/create-checkout-session) instead of using static
# Payment Links, because the 1/3/6-month tiers need to auto-cancel after
# their term (subscription_data.cancel_at), which Payment Links can't do.
# DIY's price should be a one-time price; m1/m3/m6 should be recurring
# monthly prices. Also add the webhook secret to verify
# checkout.session.completed events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DIY=
STRIPE_PRICE_1MO=
STRIPE_PRICE_3MO=
STRIPE_PRICE_6MO=

# My Macros+ — server-side only, never exposed to the browser.
MYMACROS_API_KEY=

# Absolute site URL, used for Stripe success/return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
